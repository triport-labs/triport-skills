{
  "name": "triport-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable Triport Agent Skills for Claude Code, Codex and Cursor",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "typecheck": "node scripts/check-snippets.mjs",
    "lint": "node --check scripts/validate.mjs && node --check scripts/check-snippets.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run validate && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.2",
    "github-slugger": "2.0.0",
    "markdown-it": "14.3.3",
    "typescript": "5.9.3",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  }
}
